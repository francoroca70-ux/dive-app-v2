  abrirSolo:(panelId)=>abrirSoloEstePanel(panelId),
  precio:(id,v,el)=>updateTripTypePrice(id,v,el),
  guardarTexto:(tt,it,v)=>guardarTextoDeItem(tt,it,v,null),
