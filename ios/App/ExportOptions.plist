<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used by `xcodebuild -exportArchive` in .github/workflows/mobile-build.yml to turn the
  signed archive into an .ipa ready for TestFlight/App Store upload. Manual signing:
  the archive itself was already signed with the "Apple Distribution" identity and the
  "Seven Seas Ops App Store" profile (installed from secrets earlier in the job), so
  export just needs to match that up explicitly. No App Store Connect API key needed
  for this step (only for the final upload).
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>7Y8G4Y5Y67</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.sevenseasops.app</key>
		<string>Seven Seas Ops App Store</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
