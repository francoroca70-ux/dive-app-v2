<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used by `xcodebuild -exportArchive` in .github/workflows/mobile-build.yml to turn the
  signed archive into an .ipa ready for TestFlight/App Store upload. signingStyle=automatic
  + the App Store Connect API key passed on the command line is what lets Xcode manage
  certificates and provisioning profiles on its own during CI, with no manual
  certificate/profile files to generate or store as secrets.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>7Y8G4Y5Y67</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
